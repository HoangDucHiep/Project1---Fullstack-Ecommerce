name: dockercompose16389995099968866046
services:
  ecommercebackend.api:
    build:
      context: D:\NewLearningEra\Ecommerce\source-code\ECommerceBackend
      dockerfile: API/EcommerceBackend.Api/Dockerfile
      args:
        BUILD_CONFIGURATION: Debug
        LAUNCHING_FROM_VS: "true"
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: EcommerceBackend.Api
    container_name: ecommercebackend-api
    depends_on:
      ecommercebackend.database.postgres:
        condition: service_started
        required: true
      ecommercebackend.logging.seq:
        condition: service_started
        required: true
    entrypoint:
      - dotnet
      - --roll-forward
      - Major
      - /VSTools/DistrolessHelper/DistrolessHelper.dll
      - --wait
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
      ConnectionStrings__Cache: ecommercebackend-database-redis:6379
      ConnectionStrings__Database: Host=ecommercebackend.database.postgres;Port=5432;Database=ecommerceDb;Username=admin;Password=admin;Include Error Detail=true
      Serilog__WriteTo__1__Args__serverUrl: http://ecommercebackend.logging.seq:5341
    image: ecommercebackendapi
    labels:
      com.microsoft.visual-studio.project-name: EcommerceBackend.Api
      com.microsoft.visualstudio.debuggee.arguments: ' --additionalProbingPath /.nuget/packages --additionalProbingPath /.nuget/fallbackpackages  "/app/EcommerceBackend.Api.dll"'
      com.microsoft.visualstudio.debuggee.killprogram: dotnet --roll-forward Major /VSTools/DistrolessHelper/DistrolessHelper.dll --stop dotnet
      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "5000"
        protocol: tcp
      - mode: ingress
        target: 8081
        published: "5001"
        protocol: tcp
      - mode: ingress
        target: 8080
        protocol: tcp
      - mode: ingress
        target: 8081
        protocol: tcp
    tty: true
    volumes:
      - type: bind
        source: C:\Users\HoangHiep\AppData\Roaming\Microsoft\UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\HoangHiep\AppData\Roaming\Microsoft\UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\HoangHiep\AppData\Roaming\ASP.NET\Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\HoangHiep\AppData\Roaming\ASP.NET\Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\HoangHiep\vsdbg\vs2017u5
        target: /remote_debugger
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Sdks\Microsoft.Docker.Sdk\tools\linux-x64\net6.0
        target: /VSTools
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\CommonExtensions\Microsoft\HotReload
        target: /HotReloadAgent
        read_only: true
        bind:
          create_host_path: true
  ecommercebackend.database.postgres:
    container_name: ecommercebackend-database-postgres-17
    environment:
      POSTGRES_DB: ecommerceDb
      POSTGRES_PASSWORD: admin
      POSTGRES_USER: admin
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U admin -d ecommerceDb
      timeout: 5s
      interval: 5s
      retries: 5
    image: postgres:17
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    volumes:
      - type: bind
        source: D:\NewLearningEra\Ecommerce\source-code\ECommerceBackend\.containers\db\postgres
        target: /var/lib/postgresql/data
        bind:
          create_host_path: true
      - type: bind
        source: D:\NewLearningEra\Ecommerce\source-code\ECommerceBackend\init-scripts
        target: /docker-entrypoint-initdb.d
        bind:
          create_host_path: true
  ecommercebackend.database.redis:
    container_name: ecommercebackend-database-redis
    image: redis:8.2.0
    networks:
      default: null
    ports:
      - mode: ingress
        target: 6379
        published: "6379"
        protocol: tcp
    restart: always
    volumes:
      - type: bind
        source: D:\NewLearningEra\Ecommerce\source-code\ECommerceBackend\.containers\db\redis
        target: /data
        bind:
          create_host_path: true
  ecommercebackend.idprovider.keycloak:
    command:
      - start
    container_name: ecommercebackend-idprovider-keycloak
    depends_on:
      ecommercebackend.database.postgres:
        condition: service_healthy
        required: true
    environment:
      KC_DB: postgres
      KC_DB_PASSWORD: keycloak123
      KC_DB_URL: jdbc:postgresql://ecommercebackend.database.postgres:5432/keycloakdb
      KC_DB_USERNAME: keycloak
      KC_HOSTNAME_STRICT: "false"
      KC_HOSTNAME_STRICT_HTTPS: "false"
      KC_HOSTNAME_URL: http://localhost:8080
      KC_HTTP_ENABLED: "true"
      KEYCLOAK_ADMIN: admin
      KEYCLOAK_ADMIN_PASSWORD: admin123
    image: quay.io/keycloak/keycloak:26.3
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8080"
        protocol: tcp
    volumes:
      - type: bind
        source: D:\NewLearningEra\Ecommerce\source-code\ECommerceBackend\.containers\keycloak
        target: /opt/keycloak/data
        bind:
          create_host_path: true
  ecommercebackend.logging.seq:
    container_name: ecommercebackend-logging-seq-2025
    environment:
      ACCEPT_EULA: "y"
      SEQ_FIRSTRUN_NOAUTHENTICATION: "true"
    image: datalust/seq:2025
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5341
        published: "5341"
        protocol: tcp
      - mode: ingress
        target: 80
        published: "8081"
        protocol: tcp
  ecommercebackend.pgadmin:
    container_name: ecommercebackend-pgadmin
    depends_on:
      ecommercebackend.database.postgres:
        condition: service_started
        required: true
    environment:
      PGADMIN_CONFIG_LOGIN_BANNER: '"EcommerceBackend Database Admin"'
      PGADMIN_CONFIG_SESSION_EXPIRATION_TIME: "86400"
      PGADMIN_DEFAULT_EMAIL: admin@admin.com
      PGADMIN_DEFAULT_PASSWORD: admin
    image: elestio/pgadmin:REL-9_6
    networks:
      default: null
    ports:
      - mode: ingress
        target: 80
        published: "18080"
        protocol: tcp
    volumes:
      - type: bind
        source: D:\NewLearningEra\Ecommerce\source-code\ECommerceBackend\containers\pgadmin
        target: /var/lib/pgadmin
        bind:
          create_host_path: true
networks:
  default:
    name: dockercompose16389995099968866046_default