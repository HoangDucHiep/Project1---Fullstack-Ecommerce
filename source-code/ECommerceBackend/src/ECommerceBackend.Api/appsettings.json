{
  "ConnectionStrings": {
    "Database": "",
    "Cache": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Audience": "",
    "TokenValidationParameters": {
      "ValidIssuers": []
    },
    "MetadataAddress": "",
    "RequireHttpsMetadata": false
  },
  "Encryption": {
    "Key": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Ecommerce.Api"
    }
  },
  "Jwt": {
    "AccessTokenSecretKey": "",
    "RefreshTokenSecretKey": "",
    "Issuer": "",
    "Audience": "",
    "AccessTokenExpiryMinutes": 18000,
    "RefreshTokenExpirationDays": 7
  },
  "FileStorage": {
    "StorageType": "Local",
    "LocalStoragePath": "wwwroot/uploads",
    "BaseUrl": "http://localhost:5000",
    "MaxImageSizeMB": 5,
    "MaxVideoSizeMB": 50,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp" ],
    "AllowedVideoExtensions": [ ".mp4", ".webm", ".avi", ".mov" ],
    "S3": {
      "BucketName": "",
      "Region": "",
      "AccessKey": "",
      "SecretKey": "",
      "ServiceUrl": "",
      "UseLocalStack": false,
      "PresignedUrlExpiryHours": 1
    }
  },
  "FFMpeg": {
    "RootDirectory": "/usr/bin"
  }
}