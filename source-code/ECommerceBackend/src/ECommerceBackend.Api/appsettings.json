{
  "ConnectionStrings": {
    "Database": "",
    "Cache": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Audience": "",
    "TokenValidationParameters": {
      "ValidIssuers": []
    },
    "MetadataAddress": "",
    "RequireHttpsMetadata": false
  },
  "Encryption": {
    "Key": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Ecommerce.Api"
    }
  },
  "Jwt": {
    "AccessTokenSecretKey": "",
    "RefreshTokenSecretKey": "",
    "Issuer": "",
    "Audience": "",
    "AccessTokenExpiryMinutes": 18000,
    "RefreshTokenExpirationDays": 7
  }
}
